* text=auto eol=lf
*.ico binary
*.woff2 binary
*.png binary
*.webp binary
# Only the guide's screenshots live in LFS. Everything else stays an ordinary file, because only
# the docs workflow fetches LFS: an app icon in LFS would reach CI and release builds as a pointer.
docs/img/*.png filter=lfs diff=lfs merge=lfs -text
docs/img/*.webp filter=lfs diff=lfs merge=lfs -text
